{
  "name": "@decisis/core",
  "version": "0.1.0",
  "description": "Typed decisions with deterministic policy and human override: ask a fast model typed questions, apply rules you can read, let a person overrule.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test --no-warnings 'test/*.test.ts'",
    "coverage": "node --test --no-warnings --experimental-test-coverage --test-coverage-include='src/**' 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "classification",
    "routing",
    "llm",
    "decisions",
    "jev",
    "openrouter",
    "human-in-the-loop"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.2"
  },
  "author": "Ammar Bin Ayaz",
  "homepage": "https://github.com/ammar-genai/decisis/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ammar-genai/decisis/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ammar-genai/decisis.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
