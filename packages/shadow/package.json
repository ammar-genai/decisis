    "test": "node --test 'test/*.test.mjs'",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**' 'test/*.test.mjs'",
    "eval": "node eval/run-eval.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@decisis/core": "*"
  },
  "license": "MIT",
  "author": "Ammar Bin Ayaz",
